run = "bash -c 'python -m venv .venv 2>/dev/null; .venv/bin/pip install -q -r requirements.txt && .venv/bin/python run.py'"
entrypoint = "run.py"
modules = ["python-base-3.13"]

[deployment]
run = ["sh", "-c", "python -m venv .venv 2>/dev/null && .venv/bin/pip install -q -r requirements.txt && .venv/bin/gunicorn --bind 0.0.0.0:$PORT run:app"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'python -m venv .venv 2>/dev/null; .venv/bin/pip install -q -r requirements.txt && .venv/bin/python -m gunicorn run:app --bind 0.0.0.0:5000 --workers 2 --timeout 120'"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
